# Database
POSTGRES_DB=redsinosofica_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.tudominio.mx
DJANGO_SETTINGS_MODULE=config.settings.local

# Dominio base
DOMINIO_BASE=tudominio.mx
DOMINIO_WILDCARD=*.tudominio.mx

# Email (Resend o Brevo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@tudominio.mx

# Cloudflare (R2 + Tunnel + Access)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET_NAME=redsinosofica
CLOUDFLARE_R2_ENDPOINT=https://redsinosofica.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_TUNNEL_TOKEN=

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Sentry (opcional, después de Fase 8)
SENTRY_DSN=

# Redis (opcional, para Fase 2)
REDIS_URL=redis://localhost:6379/0

# Entorno
ENVIRONMENT=local
# local, staging, production

# Logging
LOG_LEVEL=DEBUG
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security (producción)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# OTP (django-otp, Fase 8)
OTP_TOTP_ISSUER=Red Sinosófica

# Limits (por defecto)
MAX_REQUEST_SIZE_MB=50
MAX_FILE_UPLOAD_MB=25

# Auditoría
AUDIT_LOG_RETENTION_DAYS=365
